{
	"name": "german-wtf",
	"version": "0.3.0",
	"private": true,
	"description": "Master German grammar from A1 to C2 — phone-first, offline-capable PWA.",
	"type": "module",
	"engines": {
		"node": ">=24",
		"pnpm": ">=10"
	},
	"packageManager": "pnpm@12.21.0",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "pnpm content:compile && pnpm books:pack --dev && vite dev",
		"build": "pnpm content:compile && vite build",
		"preview": "tsx scripts/serve.ts build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"content:validate": "tsx scripts/content-validate.ts",
		"content:compile": "tsx scripts/content-compile.ts",
		"books:validate": "tsx scripts/books-validate.ts",
		"books:pack": "tsx scripts/books-pack.ts",
		"books:guard": "tsx scripts/books-guard.ts",
		"verify": "pnpm lint && pnpm check && pnpm test && pnpm content:validate && pnpm books:validate && pnpm build && pnpm books:guard"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@vite-pwa/sveltekit": "^2.0.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"fake-indexeddb": "^6.2.8",
		"globals": "^17.14.0",
		"magicast": "^0.5.5",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"dexie": "^4.4.7",
		"ts-fsrs": "6.0.0",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	}
}
